install.packages("devtools", "roxygen2")
roxygen2::roxygenise()
devtools::check()
devtools::build()
install.packages("lifepack")
library(lifepack)
install.packages("Rcpp")
install.packages("Rcpp")
install.packages("RcppArmadillo")  # Hvis du vil bruge Armadillo til matrixberegninger
Rcpp::compileAttributes()
library(Rcpp)
Rcpp::compileAttributes()
Rcpp::compileAttributes()
roxygen2::roxygenise()
dir("src")
Rcpp::compileAttributes()
devtools::document()
Rcpp::compileAttributes()
devtools::document()
Rcpp::compileAttributes()
devtools::clean_dll()
devtools::document()
devtools::install()
library(lifepack)
Lambda <- function(x) matrix(c(-0.1, 0.1, 0, -0.1), 2, 2)
lifepack::prodint(Lambda, 0, 80, 1000)
roxygen2::roxygenise()
devtools::clean_dll()
Rcpp::compileAttributes()
devtools::document()
devtools::install()
remove.packages("lifepack")  # Sikrer, at pakken er fjernet helt
devtools::clean_dll()        # Ryd tidligere kompilerede filer
Rcpp::compileAttributes()
devtools::document()
library(lifepack)
Lambda <- function(x) matrix(c(-0.1, 0.1, 0, -0.1), 2, 2)
prodint(Lambda, 0, 80, 1000)
